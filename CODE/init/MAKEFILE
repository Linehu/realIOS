# realinit — realIOS PID 1（静态链接，进 initramfs，最终嵌在 realboot 里）
# 用法（WSL / Linux）：make -f MAKEFILE OUT=../../.build_tmp/realinit

CC      ?= gcc
OUT     ?= ../../.build_tmp/realinit
CFLAGS  ?= -O2 -g0 -std=gnu11 -Wall -Wextra -Wno-unused-parameter -Wno-format-truncation -D_FORTIFY_SOURCE=2
LDFLAGS ?= -static -s -pthread

SRCS := main.c term.c net.c dns.c rootfs.c initconf.c ui.c util.c
HDRS := realinit.h

$(OUT): $(SRCS) $(HDRS) MAKEFILE
	@mkdir -p $(dir $(OUT))
	$(CC) $(CFLAGS) -o $@ $(SRCS) $(LDFLAGS)

clean:
	rm -f $(OUT)

.PHONY: clean
