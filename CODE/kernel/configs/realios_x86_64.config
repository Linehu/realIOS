# realIOS kernel fragment — applied on top of `make allnoconfig`.
#
# 原则：没用的全部拆掉，留下的全部 =y 编进内核镜像（不产出任何 .ko）。
# 每一行都必须在最终 .config 里成立，build_kernel.sh 会逐行核对，不成立即失败。
# 只写“必须打开”的项；被它们 select 进来的依赖（JBD2、PHYLIB…）不在这里重复。
#
# 留下的用户态接口只为三个程序服务：realinit、trans-cli（Go 静态）、busybox。
# CONFIG_EXPERT=y 是为了让 allnoconfig 下隐藏的必需项（VT、PTY、i8042、DMI…）可见可选。

# ---- 基础 ----
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BASE_FULL=y
CONFIG_MULTIUSER=y
CONFIG_POSIX_TIMERS=y
CONFIG_DMI=y
CONFIG_PCI_QUIRKS=y
CONFIG_ACPI=y
CONFIG_HPET_TIMER=y
CONFIG_MTRR=y
CONFIG_X86_PAT=y
CONFIG_KERNEL_ZSTD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# 给用户留的门：可加载模块（AI 写驱动）与 kexec（AI 换掉整个内核而不必动引导）
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KEXEC=y

# ---- 进程（Go 运行时：futex + epoll + eventfd 唤醒；madvise 归还内存）----
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FILE_LOCKING=y
CONFIG_INOTIFY_USER=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y

# ---- 终端：realinit 从 tty1 读键盘、用 pty 跑子进程；串口给 dev 版调试 ----
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# ---- 文件系统：只有 ext4（其余是内核内部的伪文件系统）----
CONFIG_EXT4_FS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_COMPRESSION_NONE=y

# ---- 引导：内核以 EFI 程序形态被 realboot 从内存加载；盘只认 GPT ----
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# ---- 存储：SATA(AHCI) / NVMe / virtio / USB 盘 ----
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y

# ---- 输入：PS/2 + USB 键盘（evdev 留给以后的图形程序）----
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# ---- 显示：UEFI GOP 帧缓冲（realinit 自己在 /dev/fb0 上画中文终端，不要 fbcon）----
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_DEVICE=y

# ---- 网络：只有 IPv4；主流有线网卡 + USB 网卡/手机共享网络 ----
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_VIRTIO_NET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_RTL8152=y

# ---- Wi-Fi：用户在 realinit 里自己填 SSID/密码；不要让 AI 去写无线栈 ----
CONFIG_PACKET=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_RFKILL=y
CONFIG_CFG80211_WEXT=y
CONFIG_FW_LOADER=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH9K=y
CONFIG_ATH9K_PCI=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8821CE=y
CONFIG_RTW88_8723DE=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT7921E=y
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC=y

# ---- 时钟（TLS 证书校验依赖正确的系统时间）----
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_CMOS=y
